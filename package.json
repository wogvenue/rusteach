{
  "name": "rusteach",
  "productName": "Rusteach",
  "version": "1.0.0",
  "description": "Sıfırdan uzmanlığa Rust öğreten etkileşimli masaüstü uygulaması",
  "author": "Rusteach",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "content": "node scripts/build-content.mjs",
    "verify": "node scripts/verify-rust.mjs",
    "web": "npm run content && vite",
    "dev": "npm run content && concurrently -k -n vite,electron \"vite --strictPort --port 5173\" \"wait-on tcp:5173 && cross-env ELECTRON_DEV_URL=http://localhost:5173 electron .\"",
    "build": "npm run content && tsc --noEmit -p tsconfig.json && vite build",
    "start": "electron .",
    "smoke": "electron . --smoke-test",
    "test:runner": "node --test electron/runner.test.mjs",
    "icon": "node scripts/make-icon.mjs",
    "pack": "npm run build && electron-builder --win --dir",
    "dist": "npm run build && electron-builder --win",
    "android:sync": "npm run build && cap sync android",
    "android:bundle": "npm run android:sync && cd android && gradlew.bat bundleRelease",
    "play": "node scripts/play.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.4",
    "@capacitor/share": "^8.0.3",
    "@capacitor/status-bar": "^8.0.4",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "@uiw/react-codemirror": "^4.25.12",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "framer-motion": "^14.1.0",
    "lucide-react": "^1.54.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "ts-fsrs": "^5.4.2",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "gray-matter": "^4.0.3",
    "js-yaml": "^5.4.3",
    "markdown-it": "^15.0.2",
    "markdown-it-container": "^4.0.0",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.5",
    "shiki": "^4.5.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "wait-on": "^9.5.1"
  },
  "build": {
    "appId": "com.rusteach.app",
    "productName": "Rusteach",
    "copyright": "Copyright © 2026 Rusteach",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "electron/**",
      "!electron/**/*.test.*",
      "package.json",
      "!node_modules/**"
    ],
    "asar": true,
    "electronDist": "node_modules/electron/dist",
    "electronLanguages": [
      "tr",
      "en-US"
    ],
    "npmRebuild": false,
    "publish": null,
    "afterPack": "./build/after-pack.cjs",
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Rusteach",
      "uninstallDisplayName": "Rusteach",
      "installerLanguages": [
        "tr_TR"
      ],
      "language": "1055",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/installerSidebar.bmp",
      "installerHeader": "build/installerHeader.bmp",
      "deleteAppDataOnUninstall": false,
      "differentialPackage": false,
      "runAfterFinish": true,
      "artifactName": "Rusteach-Kurulum-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Rusteach-Tasinabilir-${version}.${ext}"
    }
  }
}
